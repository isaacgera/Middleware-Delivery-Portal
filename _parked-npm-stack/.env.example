# ---- MDP environment configuration (copy to .env; never commit .env) ----

# --- Database (Prisma) ---
# Prototype/dev: SQLite (local file). Production: switch provider in prisma/schema.prisma
# and point DATABASE_URL at Postgres or SQL Server.
DATABASE_URL="file:./dev.db"

# --- API server ---
API_PORT=3000
API_HOST=127.0.0.1
# Comma-separated allowed origins for CORS (the web dev server)
CORS_ORIGIN="http://localhost:5173"

# --- Sessions / auth ---
# Secret used to sign the session cookie (use a long random value; CHANGE for any real deploy)
SESSION_SECRET="change-me-dev-only-secret"
# Idle session timeout in minutes (default 30; O1 to confirm with team)
SESSION_IDLE_MINUTES=30

# --- Generated document (PDF) storage ---
# Local folder for the prototype; moves to server filesystem / GitLab when deployed.
DOC_STORAGE_DIR="./storage/generated-docs"

# --- Web app (Vite) ---
# Base URL the SPA uses to reach the API
VITE_API_BASE_URL="http://localhost:3000"
