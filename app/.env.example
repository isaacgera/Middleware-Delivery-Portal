# MDP (dependency-free prototype) — copy to .env to override defaults. Never commit .env.
# All values have sensible defaults, so the app runs with no .env at all.

# Server
PORT=4000
HOST=127.0.0.1

# Session signing secret — CHANGE for any real use
SESSION_SECRET=dev-only-change-me-secret
SESSION_IDLE_MINUTES=30

# Local SQLite database file (prototype store)
# DB_PATH=./data/mdp.db

# Local folder for generated PDFs (prototype)
# DOC_STORAGE_DIR=./data/generated-docs
