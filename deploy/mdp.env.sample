# MDP production environment — copy to app/.env on the server and fill in real values.
# NEVER commit the real .env (it's gitignored). This sample carries placeholders only.

# --- Required in production ---
# Marks prod: makes the session cookie `Secure` (HTTPS-only). MUST be set.
NODE_ENV=production

# Session signing secret — generate a long random value, DO NOT reuse the dev default.
# Generate with:  node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=<paste-a-64+char-random-hex-string-here>

# --- Networking (keep on loopback; the reverse proxy is the public face) ---
HOST=127.0.0.1
PORT=4000

# --- Session policy ---
# Idle timeout in minutes (sliding). 30 is the default; confirm with the team (O1).
SESSION_IDLE_MINUTES=30

# --- Storage (point at the encrypted volume) ---
# The SQLite database file (system of record). Default is app/data/mdp.db if unset.
# DB_PATH=D:\mdp\data\mdp.db
# Where generated-doc metadata lives. Default app/data/generated-docs if unset.
# DOC_STORAGE_DIR=D:\mdp\data\generated-docs
